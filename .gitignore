```gitignore
# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Environment variables
.env
.env.*
!.env.example
!.env.*.example

# Build output
dist/
build/
client/dist/
server/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Cache
.cache/
.parcel-cache/
.vite/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/

# Local database files
*.sqlite
*.sqlite3
*.db

# Python virtual environments (if used for AI features)
.venv/
venv/
__pycache__/
*.py[cod]

# Local configuration
.env.local
.env.development.local
.env.test.local
.env.production.local
